DATABASE_URL=postgres://titun:change-me@127.0.0.1:5432/titun
AUTH_SECRET=replace-with-at-least-32-random-characters
# Used only to bootstrap the first database-backed Administrator account.
ADMIN_EMAIL=admin@titun.co
# Generate with: node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'your-password'
ADMIN_PASSWORD_HASH=
# Legacy bootstrap format; prefer ADMIN_PASSWORD_HASH for new installations.
ADMIN_PASSWORD_SCRYPT=
# Admin email verification and password recovery activate only when this is HTTPS.
NEXT_PUBLIC_SITE_URL=https://titunrenewal.com
GOOGLE_SITE_VERIFICATION=
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Required for admin verification codes, recovery and team invitations.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=TITUN <hello@titun.co>
ORDER_NOTIFICATION_EMAIL=orders@titun.co
LOW_STOCK_EMAIL=stock@titun.co
UPLOAD_DIR=/var/lib/titun/uploads
CRON_SECRET=replace-with-a-separate-random-secret
# Public contact details
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=
